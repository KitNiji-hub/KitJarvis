# Safe template only. Copy to .env locally; never commit the populated file.
# KitJarvis loads .env, but application credentials belong in its local config.
# Set this to your private, untracked configuration file if overriding defaults.
# JARVIS_CONFIG_PATH=C:/REPLACE_ME/private/config.json
JARVIS_VOICE_DEBUG=0
