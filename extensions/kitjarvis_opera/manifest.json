{
  "manifest_version": 3,
  "name": "KitJarvis Transport",
  "version": "1.0.0",
  "description": "Read-only loopback transport for KitJarvis.",
  "permissions": [
    "scripting",
    "activeTab",
    "tabs",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/kitjarvis-16.png",
    "32": "icons/kitjarvis-32.png",
    "48": "icons/kitjarvis-48.png",
    "128": "icons/kitjarvis-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/kitjarvis-16.png",
      "32": "icons/kitjarvis-32.png"
    }
  }
}
